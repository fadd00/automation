OPENROUTER_API_KEY=
PORT=3000

# OpenRouter menggunakan endpoint OpenAI-compatible dan router model gratis:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openrouter/free

# DeepSeek: gunakan key DeepSeek; endpoint dan model akan dipilih otomatis.
# DEEPSEEK_API_KEY=

# Untuk provider OpenAI-compatible lain (Ollama, LM Studio, OpenAI, Groq, dll):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
